{
  "expo": {
    "name": "Driver App",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#080c08"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "in.bikecourierservice.driver",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Bike Courier uses your location for navigation to pickup and drop points.",
          "locationWhenInUsePermission": "Bike Courier uses your location for navigation to pickup and drop points."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF4D8D",
          "sounds": [
            "./assets/old_telephone_ring.mp3"
          ],
          "mode": "production"
        }
      ],
      "./plugins/withFullScreenOrderAlert.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "3222bc75-37c6-45b2-a748-ca3a4a7f3a15"
      }
    },
    "owner": "bikeapp"
  }
}
