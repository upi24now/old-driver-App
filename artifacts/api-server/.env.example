# ═══════════════════════════════════════════════════════════════════════════════
# Environment Configuration
# Copy this file to .env and fill in the values.
# .env is for local development only — never commit it to source control.
# Production / VPS / CI: inject variables directly (PM2 ecosystem, Docker env,
# GitHub Actions secrets, etc.)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────

# TCP port the API server listens on.  REQUIRED.
PORT=5000

# Absolute path where KYC uploads are written AND served from.
# Must be the same for both multer (write) and express.static (serve).
# Default when unset: <dist>/../uploads  (relative to the built bundle).
UPLOADS_DIR=/home/bikecourierservice-api/htdocs/api.bikecourierservice.com/uploads

# Public base URL of this API server (used to build download URLs returned to
# the mobile app after a successful KYC upload).
# Include the protocol; no trailing slash.
# Default when unset: derived from the incoming Host header at request time.
API_PUBLIC_URL=https://api.bikecourierservice.com

# Runtime environment.  Affects log format (pretty vs JSON) and dev-only routes.
# Default: production
NODE_ENV=production

# ── Security ──────────────────────────────────────────────────────────────────

# Secret used to sign admin session JWTs.  REQUIRED.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── Firebase Admin SDK ─────────────────────────────────────────────────────────
#
# CHOOSE ONE of the three methods below.  The server will fail to start
# (with a clear error) if none is configured.
#
# ── Method A: Individual environment variables (recommended for Replit & PM2) ──
#
# Obtain from: Firebase console → Project settings → Service accounts →
#              Generate new private key → download JSON → copy the three fields.
#
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
#
# Paste the full private key including the -----BEGIN/END----- lines.
# In .env files: wrap in double-quotes and use literal \n for newlines:
#   FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
#
FIREBASE_PRIVATE_KEY=
#
# ── Method B: Inline service-account JSON (useful for Docker / CI secrets) ────
#
# Paste the entire contents of the downloaded service-account JSON file as a
# single-line JSON string.  Overrides Method A if both are set.
#
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
#
# ── Method C: Application Default Credentials file (GCP / Cloud Run) ──────────
#
# Set to the absolute path of the service-account JSON file on disk.
# The Firebase Admin SDK picks this up via applicationDefault() automatically.
# Used when running on GCP or with the gcloud CLI authenticated locally.
#
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Logging ───────────────────────────────────────────────────────────────────

# Pino log level: trace | debug | info | warn | error | fatal
# Default: info
# LOG_LEVEL=info

# ── Optional integrations ──────────────────────────────────────────────────────

# Razorpay credentials (required only if driver-plans / subscriptions are used)
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...

# Fast2SMS API key (required only for admin OTP SMS delivery)
# FAST2SMS_API_KEY=...

# ── Feature flags ─────────────────────────────────────────────────────────────

# Allow the hardcoded OTP "123456" for admin accounts.  Development only.
# ALLOW_DEV_ADMIN_OTP=true

# Bypass OTP for specific test phones.  Format: phone:otp,phone:otp
# Example: TEST_OTP_PHONES=9999999999:123456
# TEST_OTP_PHONES=

# Dispatch engine selector.  Values: firestore | pg_shadow | pg
# Default: firestore
# DISPATCH_SOURCE=firestore

# Postgres dispatch write gates (only meaningful when DISPATCH_SOURCE=pg)
# ALLOW_PG_DISPATCH_WRITES=true
# PG_FCM_SEND_ENABLED=true
# PG_PROJECTION_ENABLED=true
