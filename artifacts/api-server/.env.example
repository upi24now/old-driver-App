# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# Absolute path where KYC uploads are written AND served from.
# Must be consistent — both multer (write) and express.static (serve) use this.
# If unset, the server falls back to <dist>/../uploads (relative to the bundle).
UPLOADS_DIR=/home/bikecourierservice-api/htdocs/api.bikecourierservice.com/uploads

# Public base URL of this API server (used to build download URLs returned to
# the mobile app after a successful KYC upload).
# Include the protocol, no trailing slash.
API_PUBLIC_URL=https://api.bikecourierservice.com

# Session signing secret (used by express-session / auth middleware).
SESSION_SECRET=replace-with-a-long-random-string

# ── Firebase Admin ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=bike-1-wap
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@bike-1-wap.iam.gserviceaccount.com
# Paste the full private key including the -----BEGIN/END----- lines.
# In .env files, wrap the value in double-quotes to preserve newlines:
# FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
